{
  "version":"2.3.0",
  "model":"openai/gpt-oss-20b:free",
  "model_pool":[
    "openai/gpt-oss-20b:free",
    "google/gemma-4-26b-a4b-it:free",
    "openrouter/free"
  ],
  "verifier_model":"openai/gpt-oss-120b",
  "scheduler":{"utc_hours":[0,6,12,18],"minute":17,"inter_request_ms":3200,"max_retry_429":1,"max_retry_other":1},
  "budgets":{
    "max_llm_requests_per_run":26,
    "max_llm_requests_per_day":140,
    "max_web_verifiers_per_run":4,
    "max_web_verifiers_per_day":12,
    "max_web_results":8,
    "max_paid_verifier_usd_per_day":0.08,
    "max_fallback_searches_per_run":6
  },
  "retrieval":{
    "source_timeout_ms":6500,
    "gdelt_circuit_breaker_failures":2,
    "rss_cache":true,
    "fallback_when_candidates_below":2,
    "official_upstream_window_hours":96,
    "official_upstream_max_items_per_source":30
  },
  "event_clustering":{
    "claim_jaccard_threshold":0.58,
    "max_time_gap_hours":72,
    "min_token_length":4
  },
  "market":{
    "benchmark_default":"^GSPC",
    "intraday_interval":"15m",
    "intraday_range":"5d",
    "min_intraday_names":1,
    "relative_confirm_5d":0.75,
    "relative_confirm_2h":0.25,
    "relative_strong_2h":0.75
  },
  "web_verifier":{"engine":"parallel","mode":"turbo","estimated_cost_per_search_usd":0.001},
  "state_gates":{
    "watch":25,
    "arming":45,
    "active":65,
    "saturated_crowding":72,
    "max_stale_hours":18,
    "active_confirmation_runs":2,
    "deactivate_confirmation_runs":2,
    "fast_path_causal":86
  },
  "alpha":{
    "min_causal":60,
    "min_market":20,
    "max_market":64,
    "max_crowding":66,
    "min_independent_domains":2,
    "require_confirm":true,
    "require_stable_active":true,
    "max_lag_share":0.45,
    "min_empirical_reliability":0.35,
    "reliability_gate_after_samples":5
  },
  "principles":[
    "LLM extracts evidence; code decides state",
    "missing data becomes UNKNOWN or STALE, never negative evidence",
    "no ACTIVE state without independent confirmation",
    "one syndicated event counts once regardless of mirrors",
    "state changes require persistence unless fast-path physical evidence is overwhelming",
    "market confirmation is relative to a benchmark and includes intraday breadth",
    "official upstream sources run before paid web discovery",
    "no Alpha Click without stable causal state and early market confirmation",
    "no chasing when crowding or lag evidence dominates",
    "the first euro and the last euro belong to someone else"
  ]
}
