{
  "version": "1.0.0",
  "entry_rule": "NEXT_SESSION_OPEN",
  "basket_size": 5,
  "min_basket_coverage": 0.6,
  "horizons": [1, 3, 5, 10, 20],
  "max_signals": 1500,
  "backfill": {
    "enabled": true,
    "max_history_files": 300,
    "research_only": true
  },
  "sample_gate": {
    "min_completed_signals": 10,
    "min_alpha_hit_rate_pct": 55
  }
}
